{
  "name": "stationwizard",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run worker:check",
    "test": "ng test --no-watch && npm run worker:test",
    "test:watch": "ng test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "worker:check": "tsc --noEmit -p worker/tsconfig.json",
    "worker:test": "vitest run --config worker/vitest.config.ts",
    "worker:dev": "wrangler dev --local --config worker/wrangler.toml",
    "deploy": "wrangler deploy --config worker/wrangler.toml",
    "deploy:dry-run": "wrangler deploy --dry-run --config worker/wrangler.toml",
    "test:spa": "node worker/tests/spa-routing.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.22",
    "@angular/router": "21.2.22",
    "@e965/xlsx": "^0.20.3",
    "@fontsource/roboto": "^5.2.0",
    "fast-xml-parser": "^5.11.1",
    "jose": "^6.2.12",
    "material-icons": "^1.13.12",
    "pdfmake": "^0.3.5",
    "rxjs": "~7.8.0",
    "taktische-zeichen-core": "^0.10.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.23",
    "@angular/cli": "21.2.23",
    "@angular/compiler-cli": "21.2.22",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/pdfmake": "^0.3.2",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "miniflare": "^5.20260907.0-alpha",
    "playwright-core": "^1.58.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.129.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0"
}
